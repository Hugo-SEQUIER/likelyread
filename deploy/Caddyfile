{$DOMAIN} {
	encode gzip

	# Replace (not append) X-Forwarded-For with the real client address so a
	# client cannot spoof the IP stored with each hit.
	reverse_proxy server:8000 {
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output discard
	}
}
