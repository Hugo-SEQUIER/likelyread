# Likelyread Cloud (MODE=cloud). Copy to deploy/.env on the cloud server.
# Same docker-compose.yml and Caddyfile as a self-hosted server.

MODE=cloud
DOMAIN=app.likelyread.com
# Sign-in redirects, checkout return pages and the pixel URLs given to agents (MCP).
PUBLIC_URL=https://app.likelyread.com

# Signs the short-lived Google sign-in cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: https://app.likelyread.com/auth/google/callback
# Scopes used: openid, email (no Gmail access, so no Google security review).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe. Leave empty to run with billing switched off: everyone is Free.
# Developers > API keys > Create restricted key, with Write on Customers, Checkout Sessions,
# Customer portal and Subscriptions (the last cancels billing when a user deletes their
# account). Use the test-mode key while testing.
STRIPE_SECRET_KEY=
# Developers > Webhooks > Add destination https://app.likelyread.com/webhooks/stripe, events:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, charge.refunded. Then copy its signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price ids (Product catalogue > product > price > Copy price ID, price_...).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_LIFETIME=
# Stripe Tax adds VAT and sales tax at checkout. Set to false only while Stripe Tax is not set up.
STRIPE_TAX=true

# Prices shown in the dashboard. Must match the Stripe prices, which are in euros and exclude VAT.
PRICE_PRO_MONTHLY=€5
PRICE_PRO_YEARLY=€36
PRICE_LIFETIME=€59
# Lifetime deals sold before the offer closes.
LIFETIME_CAP=500

# Chrome extension ids that may receive the account token after "Sign in with Google"
# in the extension: the Chrome Web Store id, plus your unpacked id while developing.
EXTENSION_IDS=

# Accounts that see the admin numbers on their Account page.
ADMIN_EMAILS=

# Privacy defaults for a shared service.
STORE_IP=true
RETENTION_DAYS=0
IP_DAYS=30
PIXEL_RATE_PER_MIN=60
DASHBOARD=true
