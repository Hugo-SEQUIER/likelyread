# Likelyread Cloud (MODE=cloud). Copy to deploy/.env on the cloud server.
# Same docker-compose.yml and Caddyfile as a self-hosted server.

MODE=cloud
DOMAIN=app.likelyread.com
PUBLIC_URL=https://app.likelyread.com

# Signs the short-lived Google sign-in cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: https://app.likelyread.com/auth/google/callback
# Scopes used: openid, email (no Gmail access, so no Google security review).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar (merchant of record). Leave empty to run with billing switched off: everyone is Free.
# Settings > Developers > New token (scopes: checkouts:write, customer_sessions:write).
POLAR_ACCESS_TOKEN=
# Settings > Webhooks > Add endpoint https://app.likelyread.com/webhooks/polar, format Raw,
# events: order.paid, order.refunded, subscription.active, subscription.updated,
# subscription.canceled, subscription.uncanceled, subscription.revoked.
POLAR_WEBHOOK_SECRET=
# Product ids (Products > ... > Copy ID).
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_LIFETIME=
# Use https://sandbox-api.polar.sh while testing with the Polar sandbox.
POLAR_API_URL=https://api.polar.sh

# Prices shown in the dashboard. Must match the Polar products.
PRICE_PRO_MONTHLY=$5
PRICE_PRO_YEARLY=$36
PRICE_LIFETIME=$59
# Lifetime deals sold before the offer closes.
LIFETIME_CAP=500

# Chrome extension ids that may receive the account token after "Sign in with Google"
# in the extension: the Chrome Web Store id, plus your unpacked id while developing.
EXTENSION_IDS=

# Accounts that see the admin numbers on their Account page.
ADMIN_EMAILS=

# Privacy defaults for a shared service.
STORE_IP=true
RETENTION_DAYS=0
PIXEL_RATE_PER_MIN=60
DASHBOARD=true
