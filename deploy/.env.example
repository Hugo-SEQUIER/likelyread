# Domain pointing at this VPS (an A/AAAA record). Caddy gets a Let's Encrypt cert for it.
# The server also builds the pixel URLs it gives AI agents from it: https://DOMAIN.
DOMAIN=t.example.com
# Optional: the public address for those pixel URLs when it is not https://DOMAIN.
# PUBLIC_URL=

# Bearer token for the API, the dashboard and the extension. Generate with: openssl rand -hex 32
LIKELYREAD_TOKEN=

# Optional: your extension origin, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# (find the id on chrome://extensions). Leave empty if unsure: the extension still works
# through its host permission.
ALLOWED_ORIGINS=

# Hits within this many seconds around send time count as your own compose preview.
GRACE_SECONDS=20
# Hits within this many seconds after a suppress ping count as your own view.
SUPPRESS_WINDOW_SECONDS=60
# Set to false to stop storing IP addresses (privacy mode).
STORE_IP=true
# 0 keeps hits forever; otherwise hits older than this many days are purged daily.
RETENTION_DAYS=0
# Full IP addresses older than this many days are shortened to their network
# (/24 for IPv4, /48 for IPv6). Verdicts do not change. 0 keeps them in full.
IP_DAYS=30
# Pixel requests logged per IP per minute; extra requests still get the GIF but are not logged.
PIXEL_RATE_PER_MIN=60
# Set to false to disable the web dashboard at https://DOMAIN/ (the API keeps working).
DASHBOARD=true
